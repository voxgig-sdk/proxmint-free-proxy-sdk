# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 4
  metrics: count: path: 4
  metrics: count: method: 4

  entity: account: {
    path: "/api/v1/account": {
      op: list: method: *GET
      op: list: transform: res: *("`body.products`")|top
    }
  }

  entity: free_proxy: {
    path: "/api/free-proxies": {
      op: list: method: *GET
      op: list: transform: res: *("`body.rows`")|top
    }
  }

  entity: geo_ip: {
    path: "/api/geoip": {
      op: load: method: *GET
    }
  }

  entity: usage: {
    path: "/api/v1/usage": {
      op: list: method: *GET
      op: list: transform: res: *("`body.usage`")|top
    }
  }

}